{
  "name": "pw-empty",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript E2E & API framework (BasePage -> Locators -> Pages -> Tests)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --project=ui --debug",
    "ui-mode": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "check": "tsc --noEmit",
    "setup": "npm install && playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
